# ElevateMe — env template (NAMES ONLY, no secrets). Copy to .env and fill per environment.
# Never commit real .env. See backend/README.md + frontend/README.md + infra/README.md.

# --- Frontend (Vite, public) ---
VITE_API_BASE=/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Backend (Java, private — set in host env, NOT VITE_*) ---
# Database
JDBC_URL=jdbc:postgresql://localhost:5432/elevateme
JDBC_USER=app_runtime
JDBC_PASS=
# Supabase JWT verification
SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUDIENCE=authenticated
# Storage (private bucket, signed URLs via Java)
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1
STORAGE_BUCKET_PRIVATE=profile-photos-private
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Guest scoped cookie
GUEST_COOKIE_SECRET=
# CORS + public URL
ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
# Email transport
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Deploy
PORT=8080
JAVA_API_URL=https://your-java-host
