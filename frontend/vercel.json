{
  "$comment": "Mirrors infra/vercel.json (canonical) — frontend-root copy for Vercel projects rooted at frontend/. Do not diverge; edit infra/vercel.json and re-sync.",
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "${JAVA_API_URL}/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|vite.svg|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, private" },
        { "key": "Vary", "value": "Authorization, Cookie" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
