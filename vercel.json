{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [{ "source": "/evaluate/:path*", "headers": [
    { "key": "Referrer-Policy", "value": "no-referrer" },
    { "key": "Cache-Control", "value": "no-store" }
  ] }]
}
